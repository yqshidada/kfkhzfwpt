# MySQL / MariaDB connection. Copy this file to .env and update it when needed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rehab_discharge
PORT=3000
# The first startup creates this test phone account when it does not already exist.
TEST_LOGIN_PHONE=13800138000
TEST_LOGIN_PASSWORD=Test1234
# Replace with a long random string before publishing to the internet.
JWT_SECRET=replace-this-with-a-long-random-secret
# 12 hours
TOKEN_EXPIRES_IN_SECONDS=43200
# When testing QR codes on a phone over the same Wi-Fi, use this computer's LAN URL.
# Example: http://192.168.110.194:3000
SHARE_BASE_URL=
# Share links are valid for 30 days by default (1-365).
SHARE_EXPIRES_IN_DAYS=30
# PDF image reader: install Poppler, or specify full executable paths below.
# Windows example: C:/tools/poppler/Library/bin/pdfinfo.exe
PDFINFO_PATH=
PDFTOPPM_PATH=

# AES-256 key for reservation IDs: generate an independent 32-byte random hex value.
# Required for new reservations. Back up securely; do not change without migrating encrypted data.
RESERVATION_ID_KEY=
